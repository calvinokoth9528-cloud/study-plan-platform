# NextAuth — generate with: openssl rand -hex 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Database (dev = SQLite; prod = Neon Postgres)
# Local dev:
DATABASE_URL="file:./dev.db"
# Production (Vercel + Neon):
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# LLM topic breakdown (OpenAI-compatible). Leave empty to disable the feature;
# the app works fully with manual/CSV topic entry when this is empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Daily study-reminder emails (Resend). Leave RESEND_API_KEY empty to disable.
# Cron on Vercel authenticates with CRON_SECRET (Vercel sends it automatically
# as "Bearer CRON_SECRET" when the env var is set). REMINDER_SECRET is an
# alternative shared secret for external schedulers (e.g. GitHub Actions cron).
RESEND_API_KEY=
REMINDERS_FROM=Study Plan <onboarding@resend.dev>
CRON_SECRET=
REMINDER_SECRET=
